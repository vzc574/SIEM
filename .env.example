# Required for API access when running outside localhost.
SIEM_API_KEY=replace-with-a-long-random-secret
# For role-based access, use SIEM_API_KEYS instead. The optional name before
# ':' is recorded as the actor in the incident audit log, e.g.:
# SIEM_API_KEYS=noc:viewer-secret=viewer,alice:analyst-secret=analyst,root:admin-secret=admin
# Generate keys with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Reverse-proxy CIDRs whose X-Real-IP header is trusted (set by the secure overlay).
# SIEM_TRUSTED_PROXIES=172.16.0.0/12

# Optional AI reports (CLI `siem ai-report` and the dashboard "AI summary" button).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional hash reputation lookup.
VIRUSTOTAL_API_KEY=

# Optional webhook delivery for fresh alerts.
SIEM_WEBHOOK_TOKEN=

# Optional notifications for new alerts at or above this severity (default high).
SIEM_NOTIFY_MIN_SEVERITY=high
# Slack incoming webhook (also works with Mattermost/Discord Slack-compatible URLs).
SIEM_SLACK_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, then get the chat id of the target chat.
SIEM_TELEGRAM_BOT_TOKEN=
SIEM_TELEGRAM_CHAT_ID=
# Email via SMTP (STARTTLS on 587, implicit TLS on 465). SIEM_SMTP_TO is comma-separated.
SIEM_SMTP_HOST=
SIEM_SMTP_PORT=587
SIEM_SMTP_USER=
SIEM_SMTP_PASSWORD=
SIEM_SMTP_FROM=
SIEM_SMTP_TO=

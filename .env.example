# Required for API access when running outside localhost.
SIEM_API_KEY=replace-with-a-long-random-secret
# For role-based access, use SIEM_API_KEYS instead. The optional name before
# ':' is recorded as the actor in the incident audit log, e.g.:
# SIEM_API_KEYS=noc:viewer-secret=viewer,alice:analyst-secret=analyst,root:admin-secret=admin
# Generate keys with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Reverse-proxy CIDRs whose X-Real-IP header is trusted (set by the secure overlay).
# SIEM_TRUSTED_PROXIES=172.16.0.0/12

# Optional model used by `siem ai-report`.
OPENAI_MODEL=gpt-5

# Optional hash reputation lookup.
VIRUSTOTAL_API_KEY=

# Optional webhook delivery for fresh alerts.
SIEM_WEBHOOK_TOKEN=

# Required for API access when running outside localhost.
SIEM_API_KEY=replace-with-a-long-random-secret
# For role-based access, use SIEM_API_KEYS instead, e.g.:
# SIEM_API_KEYS=viewer-secret=viewer,analyst-secret=analyst,admin-secret=admin

# Optional model used by `siem ai-report`.
OPENAI_MODEL=gpt-5

# Optional hash reputation lookup.
VIRUSTOTAL_API_KEY=

# Optional webhook delivery for fresh alerts.
SIEM_WEBHOOK_TOKEN=
